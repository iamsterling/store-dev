{
  "name": "@repo/database",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/database.types.ts"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:test": "supabase test db",
    "db:test:receipts": "psql -X -v ON_ERROR_STOP=1 -f tests/resend-event-receipts.sql",
    "db:types": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit && deno check --config supabase/functions/resend-webhook/deno.json supabase/functions/resend-webhook/index.ts supabase/functions/resend-webhook/handler.test.ts",
    "lint": "deno lint supabase/functions/resend-webhook",
    "test": "deno test --allow-env --config supabase/functions/resend-webhook/deno.json supabase/functions/resend-webhook/handler.test.ts"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "deno": "2.9.6",
    "supabase": "2.121.0",
    "typescript": "5.9.3"
  }
}
